  "runtime_limits": {
    "max_steps": 4,
    "max_tokens": 512,
    "max_latency_ms": 30000,
    "max_cost": 0.2,
    "action_repeat_limit": 2,
    "unchanged_answer_limit": 2,
    "recurrence_cosine_threshold": 0.995
  },
  "program_stop_rule": {
    "maximum_properly_powered_generations": 3,
    "condition": "Stop if learned policy lacks stable positive held-out utility LCB over sham and heuristic controls"
  }
